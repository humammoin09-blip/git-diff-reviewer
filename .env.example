# ==========================================
# Git Diff Reviewer - Configuration
# ==========================================

# Active LLM Provider
# Options: openrouter | gemini | groq | ollama
LLM_PROVIDER=openrouter

# Model name (Optional: defaults are provided for each provider if left blank)
# Examples:
#   OpenRouter: anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct
#   Gemini:     gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
#   Groq:       llama-3.3-70b-versatile, llama-3.1-8b-instant
#   Ollama:     llama3, codellama, mistral, deepseek-r1:8b, qwen2.5-coder
LLM_MODEL=

# ------------------------------------------
# Provider API Keys
# ------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------
# Ollama Configuration (Local)
# ------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------
# Optional Settings
# ------------------------------------------
# Maximum character length for diffs sent to LLM (default: 40000)
MAX_DIFF_CHARS=40000

# Request timeout in seconds (default: 60)
REQUEST_TIMEOUT=60
